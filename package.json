{
  "name": "portfolio-builder",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix apps/portfolio-v3 install && npm --prefix apps/portfolio-v2 install",
    "dev:v3": "npm --prefix apps/portfolio-v3 run dev",
    "dev:v2": "npm --prefix apps/portfolio-v2 start",
    "dev:v1": "npx serve apps/portfolio-v1",
    "build:v3": "npm --prefix apps/portfolio-v3 run build",
    "build:v2": "npm --prefix apps/portfolio-v2 run build"
  }
}
